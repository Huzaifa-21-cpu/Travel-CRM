# Postgres connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Your app's public URL — used to build the shareable quote link sent over WhatsApp.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Meta WhatsApp Cloud API (developers.facebook.com/apps -> WhatsApp -> API Setup)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Any string you choose — must match what you enter in the Meta webhook config
WHATSAPP_VERIFY_TOKEN="dev-verify-token"

# Anthropic API (console.anthropic.com) — powers the "Suggest reply" AI draft button
ANTHROPIC_API_KEY=""

# Vercel Blob (Storage tab in your Vercel project -> Create Database -> Blob)
# Vercel injects this automatically in production once the store is created.
BLOB_READ_WRITE_TOKEN=""

# Stripe (dashboard.stripe.com -> Developers -> API keys) — powers plan upgrades in Settings.
# Webhook secret comes from the endpoint you register at /api/webhooks/stripe.
# Price IDs come from each recurring Price you create for the Starter/Growth/Pro products.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_PRO=""
